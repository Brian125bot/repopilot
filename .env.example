# All variables are OPTIONAL. RepoPilot runs fully hosted with zero server
# secrets: each user enters keys in the in-app Settings modal (stored only
# in their browser, sent per-request via x-jules-api-key, x-gemini-api-key,
# x-github-pat headers). Set these here only to provide server-side defaults.

# GEMINI_API_KEY: Optional server default for Gemini audit evaluation.
GEMINI_API_KEY=""

# JULES_API_KEY: Optional server default for Google Jules agent dispatch.
JULES_API_KEY=""

# GITHUB_PAT: Optional GitHub Personal Access Token (PAT) with repo scope,
# for private repository diffs and higher API rate limits.
GITHUB_PAT=""
